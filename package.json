{
	"name": "gcode-delectron",
	"displayName": "G-CODE D.Electron",
	"description": "G-CODE Language for CNC",
	"author": "Pitax",
	"license": "MIT",
	"version": "1.2.0",
	"icon": "icon/logo.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/Pitax/GCODE_D.Electron"
	},
	"publisher": "Pitax",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.82.0"
	},
	"activationEvents": [
		"onLanguage:plaintext"
	],
	"main": "./client/out/extension",
	"contributes": {
		"commands": [
			{
				"command": "gcodeDelectron.impostaGcode",
				"title": "GCODE: Imposta linguaggio GCODE"
			}
		],
		"configuration": {
			"type": "object",
			"title": "GCODE CNC",
			"properties": {
				"gcodeDelectron.cartelleCMOS": {
					"scope": "window",
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Cartelle CMOS: i file senza estensione in queste cartelle e nelle sottocartelle vengono aperti come GCODE."
				},
				"gcodeDelectron.riconoscimentoContenuto": {
					"scope": "window",
					"type": "boolean",
					"default": true,
					"description": "Riconosce come GCODE i file senza estensione il cui contenuto sembra un part-program (righe N.., G.., M.., !.., --IF/DO/LOOP/DEFINE, :OS/:TL/:PA, %)."
				},
				"languageServergcode.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 100,
					"description": "Controls the maximum number of problems produced by the server."
				},
				"languageServergcode.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		},
		"languages": [
			{
				"id": "gcode",
				"icon": {
					"light": "./icon/gcode.png",
					"dark": "./icon/gcode.png"
				},
				"aliases": [
					"GCODE",
					"g-code"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "gcode",
				"scopeName": "source.gcode",
				"path": "./syntaxes/gcode.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "gcode",
				"path": "./snippets/snippets.code-snippets"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint client/src server/src",
		"postinstall": "cd client && npm install && cd ../server && npm install && cd .."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^20.19.43",
		"eslint": "^9.39.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2"
	}
}
